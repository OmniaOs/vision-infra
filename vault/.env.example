# Vaultwarden -- secrets/config. Copia a .env y rellena en Coolify como
# variables (secrets). NO commitear .env.

# URL publica del vault (dominio de Coolify).
VAULT_DOMAIN=https://vault.omniaos.ai

# Hash argon2 del token admin del panel /admin. Generalo con:
#   docker run --rm vaultwarden/server:latest /vaultwarden hash
# (pide la contraseña admin por stdin, imprime el hash argon2 a pegar aqui).
# La contraseña en texto plano NUNCA se guarda en ningun archivo.
VAULT_ADMIN_TOKEN=

# SMTP (Mailgun) -- necesario para que las invitaciones de usuario lleguen.
# Confirmado en la practica: sin SMTP, Vaultwarden NO expone el link de
# invitacion en ningun lado accesible (ni logs, ni la UI del admin panel) --
# la nota original de esta spec ("se copia a mano") era incorrecta, quedo
# corregida aca y en 1_spec.md via /modifyspec.
# Las 5 variables van SIEMPRE juntas -- dejar alguna vacia revienta el
# arranque de Vaultwarden (ver Historial de Cambios de 1_spec.md).
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_FROM=notifications@omniaos.ai
# Usuario SMTP generado por Mailgun para el dominio (Domain settings > SMTP
# credentials) -- NO es un login de correo personal.
SMTP_USERNAME=daniel@omniaos.ai
# Password/API key que dio Mailgun para esa credencial SMTP.
SMTP_PASSWORD=
