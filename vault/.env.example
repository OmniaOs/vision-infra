# Vaultwarden -- secrets/config. Copia a .env y rellena en Coolify como
# variables (secrets). NO commitear .env.

# URL publica del vault (dominio de Coolify).
VAULT_DOMAIN=https://vault.omniaos.ai

# Hash argon2 del token admin del panel /admin. Generalo con:
#   docker run --rm vaultwarden/server:latest /vaultwarden hash
# (pide la contraseña admin por stdin, imprime el hash argon2 a pegar aqui).
# La contraseña en texto plano NUNCA se guarda en ningun archivo.
VAULT_ADMIN_TOKEN=

# SMTP: NO cableado en vault/docker-compose.yml por ahora -- Vaultwarden
# trata la sola presencia de SMTP_PORT (aunque este vacia) como "SMTP
# configurado" y exige SMTP_HOST+SMTP_FROM, asi que dejarlas vacias no
# alcanza. Mientras tanto, las invitaciones se copian a mano desde el panel
# /admin (Vaultwarden loguea el link de invitacion cuando no hay SMTP).
# Si se configura SMTP real: agregar las 5 variables (SMTP_HOST, SMTP_FROM,
# SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD) juntas al `environment:` del
# compose y sus secrets aca/en Coolify -- nunca solo una de ellas.
