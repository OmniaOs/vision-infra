# Omnia memory stack — secrets/config. Copia a .env y rellena en Coolify como
# variables (secrets). NO commitear .env.

# --- OpenMemory / Mem0 ---
# Clave maestra de la API de OpenMemory (genérala tú; la usan los devs + Hermes).
OPENMEMORY_API_KEY=
# Usuario por defecto del store.
OMNIA_MEMORY_DEFAULT_USER=omnia
# Key para embeddings (por defecto OpenAI text-embedding-3-small).
OPENAI_API_KEY=
# URL pública del API que consume la UI (dominio de Coolify del mcp).
OPENMEMORY_PUBLIC_API_URL=https://memory.omniaos.ai
# LLM de extracción/consolidación de Mem0 (opcional; por defecto OpenAI).
# Para enrutar por el gateway de Omnia (OpenAI-compatible, API keys de pago):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://gateway.omniaos.ai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small

# --- Hermes (self-learning; propone → humano aprueba) ---
# LLM programático vía el gateway LiteLLM (API key de PAGO, nunca suscripción).
HERMES_LLM_BASE_URL=https://gateway.omniaos.ai
HERMES_LLM_API_KEY=
HERMES_LLM_MODEL=glm
# Repos a observar (CSV de owner/repo).
HERMES_REPOS=OmniaOs/OmniaPOS,OmniaOs/frutal,OmniaOs/weritas
# Repo destino de las propuestas (Hermes abre PR aquí; aprobar = merge).
HERMES_PROPOSALS_REMOTE=OmniaOs/vision-infra
# Token READ (fine-grained, Contents:Read-only) para clonar los repos observados.
GITHUB_TOKEN=
# Token WRITE (fine-grained, Contents+Pull requests:Write) SOLO en vision-infra,
# para abrir el PR de propuestas. Separado del de lectura por mínimo privilegio.
HERMES_PROPOSALS_TOKEN=
# Cadencia del daemon en segundos (86400 = 1/día).
HERMES_INTERVAL=86400

# --- Access gateway (puerta unica de los devs; ver access/README.md) ---
# Un dev por entrada, "id:sha256(token)", separadas por coma. Se generan con
#   node memory/access/devs.mjs add <id>
# Solo se guarda el hash; quitar la entrada y redeploy = baja inmediata.
ACCESS_DEVS=
# Origen de Basic Memory (otro VPS) y su credencial de servicio:
# base64 de "usuario:clave" (la misma que ya protege knowledge.omniaos.ai).
KB_UPSTREAM=https://knowledge.omniaos.ai
KB_UPSTREAM_AUTH_B64=

# Politicas de acceso (roles y espacios; ver PERMISOS.md). ACCESS_DEVS admite
# "id:hash[:rol[:espacio+espacio]]"; sin rol es "miembro" sin espacios.
# Admin de emergencia (siempre rol admin): "id:hash".
ACCESS_ADMINS=
# Vacio = auditoria (solo registra). 1 = bloquear.
ACCESS_ENFORCE=

# --- Respaldo cifrado de Mem0 (backup/README.md) ---
# Clave de cifrado: GUARDALA FUERA del servidor (gestor de contrasenas). Sin ella los respaldos no se pueden abrir.
BACKUP_PASSPHRASE=
# Bucket de R2/S3 EXCLUSIVO para esto, con un token limitado a ese bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_KEEP_DAYS=30
