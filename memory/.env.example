# Omnia memory stack — secrets/config. Copia a .env y rellena en Coolify como
# variables (secrets). NO commitear .env.

# --- OpenMemory / Mem0 ---
# Clave maestra de la API de OpenMemory (genérala tú; la usan los devs + Hermes).
OPENMEMORY_API_KEY=
# Usuario por defecto del store.
OMNIA_MEMORY_DEFAULT_USER=omnia
# Key para embeddings (por defecto OpenAI text-embedding-3-small).
OPENAI_API_KEY=
# URL pública del API que consume la UI (dominio de Coolify del mcp).
OPENMEMORY_PUBLIC_API_URL=https://memory.omniaos.ai
# LLM de extracción/consolidación de Mem0 (opcional; por defecto OpenAI).
# Para enrutar por el gateway de Omnia (OpenAI-compatible, API keys de pago):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://gateway.omniaos.ai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small

# --- Hermes (self-learning; propone → humano aprueba) ---
# LLM programático vía el gateway LiteLLM (API key de PAGO, nunca suscripción).
HERMES_LLM_BASE_URL=https://gateway.omniaos.ai
HERMES_LLM_API_KEY=
HERMES_LLM_MODEL=glm
# Repos a observar (CSV de owner/repo).
HERMES_REPOS=OmniaOs/OmniaPOS,OmniaOs/frutal,OmniaOs/weritas
# Repo destino de las propuestas (Hermes abre PR aquí; aprobar = merge).
HERMES_PROPOSALS_REMOTE=OmniaOs/vision-infra
# Token de GitHub para clonar repos privados y abrir PRs de propuestas.
GITHUB_TOKEN=
# Cadencia del daemon en segundos (86400 = 1/día).
HERMES_INTERVAL=86400
