{
  "mcpServers": {
    "omnia-memory": {
      "type": "sse",
      "url": "http://localhost:8765/mcp/claude/sse/vision-infra",
      "headers": {
        "Authorization": "Bearer ${OMNIA_MEMORY_TOKEN}"
      }
    },
    "omnia-memory-global": {
      "type": "sse",
      "url": "${OMNIA_MEMORY_GLOBAL_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${OMNIA_MEMORY_TOKEN}"
      }
    }
  }
}
